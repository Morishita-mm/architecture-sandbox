{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "architecture-sandbox",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sandbox.morimizu.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

# Local development only. Never put server secrets in VITE_* variables.
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-3.5-flash-lite
AI_API_BASE_URL=https://generativelanguage.googleapis.com
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
ARCH_DEFS_PATH_DEV=../frontend/src/constants/architecture_defs.json
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_SHARE_URL=http://localhost:5173

# Set false to use the real chat API with the Vite development server.
# The built app always uses the real API.
VITE_LOCAL_CHAT=true

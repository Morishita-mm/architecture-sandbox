FROM rust:1.93-slim-bookworm AS builder
WORKDIR /build/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser
WORKDIR /app
COPY --from=builder /build/backend/target/release/app ./server
COPY frontend/src/constants/architecture_defs.json ./architecture_defs.json
ENV ARCH_DEFS_PATH=/app/architecture_defs.json
USER 10001:10001
EXPOSE 8080
CMD ["./server"]

{
  "type": "object",
  "additionalProperties": false,
  "required": ["totalScore", "details", "feedbackSections", "improvement"],
  "properties": {
    "totalScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "scalability", "security", "maintainability", "costEfficiency", "feasibility"],
      "properties": {
        "availability": {"type": "integer", "minimum": 0, "maximum": 100},
        "scalability": {"type": "integer", "minimum": 0, "maximum": 100},
        "security": {"type": "integer", "minimum": 0, "maximum": 100},
        "maintainability": {"type": "integer", "minimum": 0, "maximum": 100},
        "costEfficiency": {"type": "integer", "minimum": 0, "maximum": 100},
        "feasibility": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "feedbackSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "majorDeficiencies", "unknowns"],
      "properties": {
        "evidence": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}},
        "majorDeficiencies": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "text"],
            "properties": {
              "basis": {"type": "string", "enum": ["explicit_contradiction", "impossible_approach"]},
              "text": {"type": "string", "maxLength": 2000}
            }
          }
        },
        "unknowns": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}}
      }
    },
    "improvement": {"type": "string"}
  }
}
